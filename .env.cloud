# Cloud (production) configuration template — copy the values into your host's
# environment settings. DO NOT commit real secrets; this file holds placeholders only.
#
#   Render : Dashboard -> Service -> Environment  (or render.yaml sync:false vars)
#   Docker : infra/docker-compose.yml reads these via ${VAR}
#
# --- Database -----------------------------------------------------------
# Neon (free: 0.5GB, scale-to-zero, pgvector). Use the POOLED connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- LLM ----------------------------------------------------------------
# direct = Ollama + Gemini in-process. Gateway path was retired to
# archive/retired-direct-only/, so LLM_MODE must stay "direct".
LLM_MODE=direct
EMBED_MODE=gemini
OCR_MODE=gemini

PAYGO_CHAT_MODEL=gemini-2.0-flash
PAYGO_EMBED_MODEL=gemini-embedding-001

# Google AI Studio key. Restrict it to generativelanguage.googleapis.com.
# Leave GEMINI_API_KEY empty and set PAYGO_API_KEY instead if you prefer.
GEMINI_API_KEY=
PAYGO_API_KEY=

# --- Embeddings ---------------------------------------------------------
# MUST match the vector() width in migrations/001_init.sql. Changing this
# requires: ALTER TABLE chunks ALTER COLUMN embedding TYPE vector(<new>);
EMBED_DIM=768

# --- Retrieval ----------------------------------------------------------
CHUNK_SIZE=750
CHUNK_OVERLAP=75
TOP_K=10
FUSION_K=60
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5

# --- Uploads ------------------------------------------------------------
# NOTE: the container filesystem is ephemeral. Files under STORAGE_DIR are lost
# on redeploy/restart — vectors live in Postgres, so this is fine, but do not
# treat local uploads as durable storage.
MAX_UPLOAD_MB=20
STORAGE_DIR=var/uploads

# --- Auth ---------------------------------------------------------------
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_HOURS=12
ADMIN_EMAIL=admin@iitm.ac.in
ADMIN_PASSWORD=