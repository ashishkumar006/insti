# Copy to .env (never commit real secrets). Old .env left untouched.
DATABASE_URL=postgresql://campus:campus@localhost:5432/campusguide
LLM_MODE=direct
GATEWAY_URL=http://localhost:8109
EMBED_PROVIDER=ollama
