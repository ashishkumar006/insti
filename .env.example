# Copy to .env (never commit real secrets).
DATABASE_URL=postgresql://campus:campus@localhost:5432/campusguide
# Gemini powers embeddings + chat; OLLAMA_URL is only an offline chat fallback.
GEMINI_API_KEY=
PAYGO_API_KEY=
PAYGO_CHAT_MODEL=gemini-2.5-flash
PAYGO_EMBED_MODEL=gemini-embedding-001
OLLAMA_URL=http://127.0.0.1:11434
OCR_MODE=auto
ADMIN_EMAIL=admin@iitm.ac.in
ADMIN_PASSWORD=change-me-now
JWT_SECRET=change-me-32chars-min
