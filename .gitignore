# Secrets — never commit real credentials
.env
.env.*
!.env.example
*.pem
*.key

# Local-only folders — never upload to git
var/
archive/
data/
indexes/
__pycache__/
*.pyc
.pytest_cache/
*.log

# Local caches and one-off DBs
*.db

# Internal / binary docs (not source)
*.xlsx
var/uploads/

# Virtualenvs / tool caches
.venv/
venv/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
